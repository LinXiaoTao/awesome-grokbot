{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|svg|png|jpg|jpeg|webp|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/bot/product-lead",
      "destination": "/en/bot/mercury-product-lead",
      "permanent": true
    },
    {
      "source": "/bot/firstmate-the-only-bot-you-talk-to",
      "destination": "/en/bot/firstmate",
      "permanent": true
    },
    {
      "source": "/:locale(en|zh|ja|ko|es|fr|de)/bot/product-lead",
      "destination": "/:locale/bot/mercury-product-lead",
      "permanent": true
    },
    {
      "source": "/:locale(en|zh|ja|ko|es|fr|de)/bot/firstmate-the-only-bot-you-talk-to",
      "destination": "/:locale/bot/firstmate",
      "permanent": true
    },
    {
      "source": "/:locale(en|zh|ja|ko|es|fr|de)/bot/apps",
      "destination": "/:locale?category=engineering",
      "permanent": true
    },
    {
      "source": "/bot/apps",
      "destination": "/en?category=engineering",
      "permanent": true
    },
    {
      "source": "/bot/:slug",
      "destination": "/en/bot/:slug",
      "permanent": true
    },
    {
      "source": "/bot/:slug/",
      "destination": "/en/bot/:slug",
      "permanent": true
    }
  ]
}
